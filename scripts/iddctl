#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE=${IDD_CONFIG_FILE:-/etc/idd/virtual-display.conf}
KMSCTL=${IDD_KMSCTL:-/usr/local/bin/idd-kmsctl}
SERVICE=idd-virtual-display.service
HEADLESS_NAME=${IDD_HEADLESS_NAME:-IDD-HEADLESS}

fail() { printf 'iddctl: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"; }

load_config() {
    [[ -r "$CONFIG_FILE" ]] || fail "configuration not found: $CONFIG_FILE (install the guest driver first)"
    # This file is created by the installer and contains only IDD_MODE.
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    : "${IDD_MODE:=1920x1080@60}"
    [[ "$IDD_MODE" =~ ^([0-9]{3,5})x([0-9]{3,5})@([0-9]{1,3})$ ]] || \
        fail "invalid IDD_MODE '$IDD_MODE' in $CONFIG_FILE (expected WIDTHxHEIGHT@HZ)"
    local width=${BASH_REMATCH[1]} height=${BASH_REMATCH[2]} refresh=${BASH_REMATCH[3]}
    (( width >= 640 && width <= 7680 && height >= 480 && height <= 4320 && refresh >= 24 && refresh <= 240 )) || \
        fail "IDD_MODE is outside safe defaults (640x480..7680x4320, 24..240 Hz)"
}

case "${1:-}" in
    start)
        need systemctl
        systemctl start "$SERVICE"
        ;;
    enable)
        need systemctl
        systemctl enable --now "$SERVICE"
        ;;
    stop)
        need systemctl
        systemctl stop "$SERVICE"
        ;;
    restart)
        need systemctl
        systemctl restart "$SERVICE"
        ;;
    disable)
        need systemctl
        systemctl disable --now "$SERVICE"
        ;;
    status)
        need systemctl
        systemctl --no-pager --full status "$SERVICE" || true
        if [[ -x "$KMSCTL" ]]; then "$KMSCTL" status || true; fi
        ;;
    verify)
        printf '%s\n' '=== Guest NVIDIA ==='
        if command -v nvidia-smi >/dev/null 2>&1; then
            nvidia-smi --query-gpu=name,driver_version,pci.bus_id --format=csv,noheader || true
            printf '\nNVIDIA utilization/processes (check the compositor while a session is drawing):\n'
            nvidia-smi || true
        else
            printf '%s\n' 'nvidia-smi not found'
        fi
        printf '\nnvidia_drm modeset: '
        if [[ -r /sys/module/nvidia_drm/parameters/modeset ]]; then
            cat /sys/module/nvidia_drm/parameters/modeset
        else
            printf '%s\n' 'not loaded'
        fi
        printf '\n=== DRM devices ===\n'
        shopt -s nullglob
        for card in /sys/class/drm/card[0-9]*; do
            name=${card##*/}
            [[ "$name" =~ ^card[0-9]+$ ]] || continue
            driver=$(readlink -f "$card/device/driver" 2>/dev/null || true)
            driver=${driver##*/}
            device=$(readlink -f "$card/device" 2>/dev/null || true)
            printf '%-8s driver=%-12s device=%s\n' "$name" "${driver:-unknown}" "${device:-unknown}"
            for status in "$card"-*/status; do
                [[ -r "$status" ]] || continue
                connector=${status%/status}; connector=${connector##*/}
                printf '  %-22s %s\n' "$connector" "$(cat "$status")"
            done
        done
        printf '\n=== Hermes-KMS driver ===\n'
        if command -v modinfo >/dev/null 2>&1; then modinfo -F version hermes_kms 2>/dev/null || printf '%s\n' 'not installed'; fi
        if [[ -x "$KMSCTL" ]]; then "$KMSCTL" version || true; "$KMSCTL" identity || true; fi
        ;;
    activate-kde)
        load_config
        need kscreen-doctor
        outputs=$(kscreen-doctor -o)
        output_id=$(awk '$1 == "Output:" && $3 == "HERMES-1" { print $2; exit }' <<<"$outputs")
        [[ -n "$output_id" ]] || fail 'HERMES-1 is not visible to KScreen yet. Check: iddctl status'
        kscreen-doctor "output.${output_id}.enable" "output.${output_id}.mode.$IDD_MODE"
        ;;
    activate-gnome)
        need gnome-control-center
        exec gnome-control-center display
        ;;
    activate-wlr)
        load_config
        need wlr-randr
        outputs=$(wlr-randr)
        grep -Fq 'HERMES-1' <<<"$outputs" || fail 'HERMES-1 is not visible to the wlr-output-management protocol yet'
        exec wlr-randr --output HERMES-1 --on --custom-mode "${IDD_MODE}Hz"
        ;;
    hyprland-start)
        load_config
        [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || fail 'run this inside the target Hyprland session (HYPRLAND_INSTANCE_SIGNATURE is unset)'
        need hyprctl
        need wlr-randr
        if ! hyprctl monitors all 2>/dev/null | grep -Fq "Monitor $HEADLESS_NAME ("; then
            hyprctl output create headless "$HEADLESS_NAME"
        fi
        for _ in $(seq 1 30); do
            if wlr-randr 2>/dev/null | grep -Fq "$HEADLESS_NAME"; then break; fi
            sleep 0.2
        done
        wlr-randr --output "$HEADLESS_NAME" --on --custom-mode "${IDD_MODE}Hz" --pos 0,0 --scale 1
        printf 'Created %s in Hyprland at %s. This is a compositor headless output, not a DRM connector.\n' "$HEADLESS_NAME" "$IDD_MODE"
        ;;
    hyprland-stop)
        [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || fail 'run this inside the target Hyprland session (HYPRLAND_INSTANCE_SIGNATURE is unset)'
        need hyprctl
        hyprctl output remove "$HEADLESS_NAME"
        ;;
    _hold)
        load_config
        [[ -x "$KMSCTL" ]] || fail "$KMSCTL not installed"
        exec "$KMSCTL" hold "$IDD_MODE"
        ;;
    *)
        cat >&2 <<'USAGE'
Usage: iddctl COMMAND
  enable          enable the guest-local Hermes-KMS display service at boot
  start|stop|restart|disable|status
  verify          inspect NVIDIA, DRM cards and the guest virtual display
  activate-kde    enable HERMES-1 in the current KDE Wayland session
  activate-gnome  open GNOME Display Settings to enable HERMES-1
  activate-wlr    enable HERMES-1 through wlr-output-management
  hyprland-start  create a Hyprland headless output (not a DRM connector)
  hyprland-stop   remove the Hyprland headless output
USAGE
        exit 2
        ;;
esac
